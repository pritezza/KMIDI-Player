<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- ピアノロールを GPU で描くため（WPF は .NET Framework に含まれる。追加のインストールは不要） -->
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>KMidiPlayer</RootNamespace>
    <AssemblyName>KMidiPlayer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- エクスプローラーやタスクバーに出る exe のアイコン -->
    <ApplicationIcon>KMidiPlayer.ico</ApplicationIcon>

    <Product>KMIDI Player</Product>
    <AssemblyTitle>KMIDI Player</AssemblyTitle>
    <Version>1.0.0</Version>
    <!-- バージョン情報にコミットのハッシュ値を付けない -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- ウィンドウのタイトルバーのアイコン。exe のアイコンはウィンドウには自動で使われないため、埋め込んで読み込む -->
    <EmbeddedResource Include="KMidiPlayer.ico" LogicalName="KMidiPlayer.ico" />
  </ItemGroup>

</Project>
